# Port to listen on (Railway sets this for you).
PORT=5190

# Where the SQLite database (including uploaded files) lives. On Railway, mount a volume; its path is
# picked up from RAILWAY_VOLUME_MOUNT_PATH automatically.
DATA_DIR=./data

# The public address. Used in links the API hands out, and for the Every sign-in callback.
# PUBLIC_URL=https://tiergrader.example.com

# Who can create collections (ranking never needs an account):
#  - Every sign-in: set the client below. Every subscribers sign in and create; agents use keys they make.
#  - A shared key: set CREATE_KEY only.
#  - Anyone: set neither (fine for local use). A public deploy refuses to start this way unless
#    ALLOW_OPEN_CREATE=1 is set too.
# CREATE_KEY also works alongside Every sign-in, as an operator override.
#
# Every OAuth client: ask the Every team to provision one with the redirect URI
# <PUBLIC_URL>/auth/every/callback (exactly) and the scope basic_profile.
# EVERY_OAUTH_CLIENT_ID=
# EVERY_OAUTH_CLIENT_SECRET=
# EVERY_OAUTH_BASE_URL=https://every.to
# CREATE_KEY=

# Optional: a Chrome origin-trial token for WebMCP, so visitors' Chrome exposes the page's agent tools
# without flags. Register the deployed origin at
# https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
# WEBMCP_ORIGIN_TRIAL_TOKEN=
